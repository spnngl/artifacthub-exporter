# Based on https://github.com/gitattributes/gitattributes (Common + Go)

# Auto detect text files and perform LF normalization
*          text=auto

# Go: no git magic on line endings
*.go       -text diff=golang
go.mod     text eol=lf
go.sum     text eol=lf

# Build files (Makefile requires tabs + LF)
Makefile   text eol=lf
Dockerfile text eol=lf
*.mk       text eol=lf

# Documents
*.md       text diff=markdown
*.txt      text

# Scripts
*.bash     text eol=lf
*.sh       text eol=lf

# Serialisation
*.json     text
*.json5    text
*.toml     text
*.yaml     text
*.yml      text

# Templates
*.tmpl     text
*.html     text diff=html

# Graphics
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.svg      text

# Archives
*.gz       binary
*.tar      binary
*.tgz      binary
*.zip      binary
*.zst      binary

# Text files where line endings should be preserved
*.patch    -text

# Exclude files from exporting
.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore
